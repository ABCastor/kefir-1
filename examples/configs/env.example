# Nothing in this repository reads a .env file: these variables are read from the environment.
# Export them, or copy this file to .env at the repository root and load it with `set -a; . ./.env; set +a`. Never commit credentials.
# Needed only for Hugging Face shard/checkpoint storage and W&B logging during pretraining.
HF_TOKEN=
WANDB_API_KEY=
WANDB_ENTITY=
